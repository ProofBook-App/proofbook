# Names only. Copy to .env and fill in. Never commit .env.
MONAD_RPC_URL=
ALCHEMY_MONAD_RPC_URL=
# Indexer (indexer/.env): HyperSync token from https://envio.dev/app/api-tokens. Without it, testnet syncs over RPC.
ENVIO_API_TOKEN=
MONAD_TESTNET_RPC_URL=
ETHERSCAN_API_KEY=
DEPLOYER_PK=
GUARDIAN_ADDRESS=
SESSION_KEY_PK_1=
SESSION_KEY_ADDRESS_1=
SESSION_KEY_PK_2=
SESSION_KEY_PK_3=
PRIVY_APP_ID=
# Optional. Workers use bindings + `wrangler login`; these are only for CI deploys or calling Workers AI from outside a Worker.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
PRIVY_APP_SECRET=
# Privy authorization key (P-256 PKCS8, "wallet-auth:..."). Owns the house-agent wallet + policy; signs every /rpc call. spikes/privy generates it.
PRIVY_AUTH_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
